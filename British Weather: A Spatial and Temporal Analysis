:600;margin-left:12px;\">The Snapshot in Space</span>\n</div>","metadata":{}},{"id":"ef8c63ae","cell_type":"code","source":"import geopandas as gpd\nfrom io import BytesIO\n\ngeo_resp = SESSION.get(\n    'https://raw.githubusercontent.com/nvkelso/natural-earth-vector/master/geojson/ne_110m_admin_0_map_units.geojson',\n    timeout=20)\nuk_shapes = gpd.read_file(BytesIO(geo_resp.content))\nuk_outline = uk_shapes[uk_shapes['ADM0_A3'].isin(['GBR', 'IRL'])]\n\nfig, ax = plt.subplots(figsize=(9, 11))\nuk_outline.plot(ax=ax, color='#f0efee', edgecolor='white', linewidth=0.8)\nsc = ax.scatter(weather['lon'], weather['lat'], c=weather['temp_C'], cmap='Reds',\n                 s=90, edgecolor='white', linewidth=0.8, zorder=3)\nfor _, row in weather.iterrows():\n    ax.annotate(row['City'], (row['lon'], row['lat']), fontsize=6.5, color=RUST,\n                xytext=(3, 3), textcoords='offset points')\nax.set_xlim(-8.5, 2); ax.set_ylim(49.8, 60.9); ax.set_axis_off()\nax.set_title(f\"Plot 1. Current temperature across {len(weather)} UK cities\\n\"\n             f\"(snapshot: {weather['dt_dt'].median().strftime('%d %b %Y, %H:%M UTC')})\",\n             fontsize=13, color=RUST, fontweight='bold', pad=10)\ncbar = plt.colorbar(sc, ax=ax, fraction=0.04, pad=0.02)\ncbar.set_label('Temperature (\\u00b0C)', color=RUST)\nplt.tight_layout(); plt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-12T19:13:44.843527Z","iopub.execute_input":"2026-09-12T19:13:44.843885Z","iopub.status.idle":"2026-09-12T19:13:48.999165Z","shell.execute_reply.started":"2026-09-12T19:13:44.843859Z","shell.execute_reply":"2026-09-12T19:13:48.997922Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 900x1100 with 2 Axes>","image/png":""},"metadata":{}}],"execution_count":7},{"id":"bb61fc9f","cell_type":"markdown","source":"<div style=\"background:linear-gradient(135deg,#f5f5f4,#e7e5e4);border:1px solid #78716c44;border-left:5px solid #78716c;border-radius:0 12